# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# .env*
# !.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


.vs/
bin/
obj/

# Root: accidental `dotnet build/publish -o build-...` output (local compile checks; not source)
/build-*/

# Backend: never commit accidental nested `dotnet build -o` output (breaks MAX_PATH / static web assets copy)
DMS-Backend/_b/
DMS-Backend/_buildcheck*/
DMS-Backend/_cbcheck*/
DMS-Backend/_compilecheck*/
DMS-Backend/_sscheck/
DMS-Backend/bin-checkbuild*/
DMS-Backend/build-out-check/

# Backend logs — runtime-generated, never commit
DMS-Backend/logs/

# One-off SQL fix scripts — applied to DB, kept only locally if needed
sql/
DMS-Backend/*.sql
DMS-Backend/Data/fix_super_admin_index.sql

docs
.env
.env.development