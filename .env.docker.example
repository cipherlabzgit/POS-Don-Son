# ===========================================================================
# Don & Sons DMS — Docker Compose environment template
#
# Copy to ".env" at repo root:
#   cp .env.docker.example .env          (Linux / macOS)
#   Copy-Item .env.docker.example .env   (Windows PowerShell)
#
# Then edit .env and run:
#   ./scripts/deploy-client.sh           (Linux)
#   .\scripts\deploy-client.ps1          (Windows)
#
# See DOCKER.md for full client deployment steps.
# NEVER commit the .env file.
# ===========================================================================
#
# SERVER MINIMUM (required for database tables to be created):
#   POSTGRES_USER=postgres
#   POSTGRES_PASSWORD=postgres
#   JWT_SECRET_KEY=<at least 32 random characters>
#   SUPERADMIN_PASSWORD=<your admin login password>
#
# Tables are created when the BACKEND starts (not by Postgres alone).
# After editing .env:  docker compose down -v && docker compose up -d --build
# ===========================================================================

# ---------------------------------------------------------------------------
# Client server address
# Set to the IP or domain users type in the browser (NOT localhost on remote servers).
# Example: 192.168.1.100  or  dms.yourclient.com
# Use the same host in FRONTEND_URL, NEXT_PUBLIC_API_URL, POS_URL, VITE_API_URL below.
# ---------------------------------------------------------------------------
CLIENT_HOST=YOUR_SERVER_IP_OR_DOMAIN

# ---------------------------------------------------------------------------
# PostgreSQL
# POSTGRES_* applies ONLY on first volume init. Password changes later need
# scripts/Sync-DockerPostgresPassword.ps1 or docker compose down -v (wipes data).
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dms_erp_db
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Backend (.NET 10)
# ---------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
BACKEND_PORT=5126

# JWT — generate: openssl rand -base64 48
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ISSUER=DMS-ERP-Backend
JWT_AUDIENCE=DMS-ERP-Frontend
JWT_ACCESS_MINUTES=1440
JWT_REFRESH_DAYS=7

# Bootstrap admin (created on first run)
SUPERADMIN_EMAIL=admin@donandson.com
SUPERADMIN_FIRSTNAME=System
SUPERADMIN_LASTNAME=Administrator
SUPERADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# First install: true = demo users, roles, products, showrooms
# Production after go-live: false
DEV_SEED_ENABLED=true

# ---------------------------------------------------------------------------
# DMS Frontend (Next.js) — URLs must be reachable from the USER'S BROWSER
# Replace YOUR_SERVER_IP_OR_DOMAIN with CLIENT_HOST value above.
# ---------------------------------------------------------------------------
FRONTEND_PORT=3000
FRONTEND_URL=http://YOUR_SERVER_IP_OR_DOMAIN:3000
NEXT_PUBLIC_API_URL=http://YOUR_SERVER_IP_OR_DOMAIN:5126

# ---------------------------------------------------------------------------
# POS web UI (browser, not Electron) — same browser-reachable API URL
# ---------------------------------------------------------------------------
POS_PORT=5174
POS_URL=http://YOUR_SERVER_IP_OR_DOMAIN:5174
VITE_API_URL=http://YOUR_SERVER_IP_OR_DOMAIN:5126

# ---------------------------------------------------------------------------
# HTTPS example (uncomment and rebuild after setting domains + reverse proxy)
# ---------------------------------------------------------------------------
# CLIENT_HOST=dms.client.com
# FRONTEND_URL=https://dms.client.com
# NEXT_PUBLIC_API_URL=https://api.client.com
# POS_URL=https://pos.client.com
# VITE_API_URL=https://api.client.com
