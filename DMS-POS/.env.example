# Don and Sons POS - Electron desktop build
# API URL is baked in at build time (npm run build).
#
# On client server, this is set automatically by:
#   ..\scripts\build-pos-installer.ps1
# from the repo root .env (VITE_API_URL or CLIENT_HOST).
#
# Manual build:
#   VITE_API_URL=http://YOUR_SERVER_IP:5126

VITE_API_URL=http://123.231.10.22:5126
