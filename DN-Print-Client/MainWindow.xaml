<Window x:Class="DN_Print_Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DN Print Client — Don &amp; Sons"
        Height="560" Width="720"
        MinHeight="420" MinWidth="640"
        Background="#F5F5F5">
  <DockPanel Margin="16">
    <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Hybrid DN Print Client" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10"
                   Text="Set API Base URL to the DMS server (e.g. http://192.168.1.10:5000). Heartbeats keep the web portal Online. Delivery Notes print to this PC's Windows default printer unless another printer is selected."
                   TextWrapping="Wrap" FontSize="11" Foreground="#666" />

        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,8">
          <TextBlock Text="API Base URL" FontSize="11" Foreground="#666" />
          <TextBox x:Name="ApiBaseUrlBox" Height="28" Padding="4,4" />
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,8">
          <TextBlock Text="Client Key (X-DN-Print-Client-Key)" FontSize="11" Foreground="#666" />
          <TextBox x:Name="ClientKeyBox" Height="28" Padding="4,4" />
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,8">
          <TextBlock Text="Station Code" FontSize="11" Foreground="#666" />
          <TextBox x:Name="StationCodeBox" Height="28" Padding="4,4" />
        </StackPanel>
        <StackPanel Grid.Row="3" Grid.Column="1" Margin="8,0,0,8">
          <TextBlock Text="Windows Printer" FontSize="11" Foreground="#666" />
          <ComboBox x:Name="PrinterBox" Height="28" IsEditable="True" />
        </StackPanel>

        <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" Margin="0,4,0,0">
          <Button x:Name="SaveBtn" Content="Save Settings" Width="120" Height="30" Margin="0,0,8,0" Click="SaveBtn_OnClick" />
          <Button x:Name="StartBtn" Content="Start Polling" Width="120" Height="30" Margin="0,0,8,0" Click="StartBtn_OnClick" />
          <Button x:Name="StopBtn" Content="Stop" Width="80" Height="30" IsEnabled="False" Click="StopBtn_OnClick" />
        </StackPanel>
        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
          <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontWeight="SemiBold" Text="Stopped" Foreground="#B45309" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="10">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Activity Log" FontWeight="SemiBold" Margin="0,0,0,8" />
        <ListBox x:Name="LogList" BorderThickness="0" FontFamily="Consolas" FontSize="12" />
      </DockPanel>
    </Border>
  </DockPanel>
</Window>
