# ===========================================================================
# Don & Sons DMS — Client server .env (local PostgreSQL in pgAdmin)
#
# Deploy with pgAdmin database (NOT Docker postgres):
#   Copy-Item .env.client-ready .env
#   notepad .env
#   .\scripts\deploy-client-local-pg.ps1
#
# See PGADMIN-LOCAL.md
# ===========================================================================

CLIENT_HOST=192.168.8.128

# Local PostgreSQL 18 (pgAdmin) — must match your pgAdmin login
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dms_erp_db
POSTGRES_PORT=5432

ASPNETCORE_ENVIRONMENT=Production
BACKEND_PORT=5126

JWT_SECRET_KEY=DonAndSon-DMS-JWT-Secret-Key-2026-Minimum32Chars
JWT_ISSUER=DMS-ERP-Backend
JWT_AUDIENCE=DMS-ERP-Frontend
JWT_ACCESS_MINUTES=1440
JWT_REFRESH_DAYS=7

SUPERADMIN_EMAIL=admin@donandson.com
SUPERADMIN_FIRSTNAME=System
SUPERADMIN_LASTNAME=Administrator
SUPERADMIN_PASSWORD=SuperAdmin@2026!Dev

DEV_SEED_ENABLED=true

FRONTEND_PORT=3000
FRONTEND_URL=http://192.168.8.128:3000
NEXT_PUBLIC_API_URL=http://192.168.8.128:5126

POS_PORT=5174
POS_URL=http://192.168.8.128:5174
VITE_API_URL=http://192.168.8.128:5126
