# ===========================================================================
# Don & Sons DMS — Docker Compose environment template
#
# Copy this file to ".env" at the repo root and fill in real values:
#     cp .env.docker.example .env       (Linux / macOS / WSL)
#     copy .env.docker.example .env     (Windows cmd)
#     Copy-Item .env.docker.example .env  (Windows PowerShell)
#
# NEVER commit the resulting .env file (it is git-ignored by default).
# ===========================================================================

# ---------------------------------------------------------------------------
# PostgreSQL
#
# POSTGRES_PASSWORD (and USER) are read ONLY on the first init of the DB
# volume. After that, changing this file does NOT change the real DB password.
# If the backend logs "28P01: password authentication failed", either set
# POSTGRES_PASSWORD back to the value used at first `docker compose up`, run
# `ALTER USER ... PASSWORD` in psql, or remove the volume:
# If the backend logs "28P01: password authentication failed", run from repo root:
#   .\scripts\Sync-DockerPostgresPassword.ps1
#   docker compose up -d
# ---------------------------------------------------------------------------
POSTGRES_USER=dms_user
POSTGRES_PASSWORD=10158
POSTGRES_DB=dms_erp_db
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Backend (.NET 10 / ASP.NET Core)
# ---------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
BACKEND_PORT=5126

# JWT — MUST be at least 32 characters of high-entropy text.
# Generate one with:    openssl rand -base64 48
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ISSUER=DMS-ERP-Backend
JWT_AUDIENCE=DMS-ERP-Frontend
JWT_ACCESS_MINUTES=1440
JWT_REFRESH_DAYS=7

# Initial bootstrap admin (created on first run by the SuperAdminSeeder)
SUPERADMIN_EMAIL=admin@donandson.com
SUPERADMIN_FIRSTNAME=System
SUPERADMIN_LASTNAME=Administrator
SUPERADMIN_PASSWORD=SuperAdmin@2026!Dev

# Set to "true" only on a fresh database where you want demo data
DEV_SEED_ENABLED=false

# ---------------------------------------------------------------------------
# Frontend (Next.js 16)
#
# NEXT_PUBLIC_API_URL is consumed by the BROWSER, so it must be a URL the
# user's browser can reach — typically the host-mapped backend port.
# In production behind a reverse proxy / domain, set it to the public URL,
# e.g. https://api.donandson.com
# ---------------------------------------------------------------------------
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5126

# ---------------------------------------------------------------------------
# POS (Vite + React 19 web UI, served by nginx)
#
# VITE_API_URL is consumed by the BROWSER at runtime, so it must be a URL
# the cashier's browser can reach — typically the host-mapped backend port.
# In production behind a reverse proxy, set it to the public backend URL,
# e.g. https://api.donandson.com
#
# POS_URL must match POS_PORT so the backend CORS policy accepts requests
# from the POS web app.
# ---------------------------------------------------------------------------
POS_PORT=5174
POS_URL=http://localhost:5174
VITE_API_URL=http://localhost:5126
